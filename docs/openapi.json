  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 30,
            "title": "History"
          },
          "context": {
            "type": "string",
            "maxLength": 4000,
            "title": "Context",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AgentRequest"
      },
      "Body_converse_api_voice_converse_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "history": {
            "type": "string",
            "title": "History",
            "default": "[]"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_converse_api_voice_converse_post"
      },
      "Body_transcribe_api_voice_transcribe_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_transcribe_api_voice_transcribe_post"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "CodeSearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Query"
          },
          "path": {
            "type": "string",
            "maxLength": 500,
            "title": "Path",
            "default": "backend"
          },
          "max_matches": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Matches",
            "default": 30
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "CodeSearchRequest"
      },
      "DiffRequest": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Path"
          },
          "proposed_content": {
            "type": "string",
            "maxLength": 200000,
            "title": "Proposed Content"
          }
        },
        "type": "object",
        "required": [
          "path",
          "proposed_content"
        ],
        "title": "DiffRequest"
      },
      "FileRequest": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "FileRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspectRequest": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500,
            "title": "Path",
            "default": "backend"
          },
          "max_files": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Files",
            "default": 50
          }
        },
        "type": "object",
        "title": "InspectRequest"
      },
      "MemoryChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MemoryChatRequest"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "ResearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 300,
            "minLength": 2,
            "title": "Query"
          },
          "max_results": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Max Results",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
